GOOGLE_API_KEY=your-gemini-api-key-here
CHROMADB_HOST=localhost
CHROMADB_PORT=8001

# LLM Configuration
LLM_PROVIDER=gemini # or "groq"

# Gemini
GOOGLE_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# Groq
GROQ_API_KEY=your-groq-api-key-here
